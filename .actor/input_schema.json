{
    "title": "Amazon Books Scraper Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "startUrl": {
            "title": "Start URL",
            "type": "string",
            "description": "Amazon books category URL to scrape",
            "editor": "textfield",
            "default": "https://www.amazon.com/s?i=stripbooks&rh=n%3A283155"
        },
        "maxPages": {
            "title": "Max Pages",
            "type": "integer",
            "description": "Maximum pages to scrape",
            "default": 2,
            "minimum": 1
        }
    },
    "required": ["startUrl"]
}